{
  "permissions": {
    "allow": [
      "WebFetch(domain:docs.claude.com)",
      "Bash(make check)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(make format)",
      "Bash(make format-check)",
      "Bash(make install-hooks)",
      "Bash(make clean)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force*)",
      "Bash(git commit*--no-verify*)",
      "Bash(git reset --hard*)"
    ]
  }
}
